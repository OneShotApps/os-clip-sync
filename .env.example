# Copy this file to .env for compose.dev.yaml or compose.prod.yaml.
# Never place real production secrets in a committed file.
CLIP_SYNC_IMAGE_TAG=dev
CLIP_SYNC_API_PORT=4100
CLIP_SYNC_POSTGRES_USER=clip_sync
CLIP_SYNC_POSTGRES_PASSWORD=replace-with-a-long-database-password
CLIP_SYNC_POSTGRES_DATABASE=clip_sync
CLIP_SYNC_POSTGRES_URL=postgres://clip_sync:replace-with-a-long-database-password@postgres:5432/clip_sync
CLIP_SYNC_MONGO_USER=clip_sync
CLIP_SYNC_MONGO_PASSWORD=replace-with-a-long-mongodb-password
CLIP_SYNC_MONGO_URL=mongodb://clip_sync:replace-with-a-long-mongodb-password@mongo:27017/clip_sync?authSource=admin
CLIP_SYNC_JWT_SECRET=replace-with-at-least-32-random-characters
CLIP_SYNC_AUTH_CODE_PEPPER=replace-with-a-different-32-character-secret
CLIP_SYNC_GOOGLE_CLIENT_IDS=replace.apps.googleusercontent.com
CLIP_SYNC_SMTP_HOST=smtp.example.com
CLIP_SYNC_SMTP_PORT=587
CLIP_SYNC_SMTP_SECURE=false
CLIP_SYNC_SMTP_USER=replace-with-smtp-user
CLIP_SYNC_SMTP_PASSWORD=replace-with-smtp-password
CLIP_SYNC_EMAIL_FROM=no-reply@example.com
CLIP_SYNC_CORS_ORIGINS=https://app.example.com
